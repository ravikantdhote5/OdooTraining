<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <menuitem id="menu_hr_root"
              name="HR"
              sequence="10"
              groups="base.group_user"/>

    <record id="action_skill" model="ir.actions.act_window">
      <field name="name">Skills</field>
      <field name="res_model">emp.skill</field>
      <field name="view_mode">list,form</field>
      <field name="groups_id" eval="[(4, ref('employee_management_system.group_skill_manager'))]"/>
    </record>

    <menuitem id="menu_skill_root"
              name="Skills"
              parent="menu_hr_root"
              sequence="1"
              groups="base.group_user"/>

    <menuitem id="menu_skill"
              name="Manage Skills"
              parent="menu_skill_root"
              action="action_skill"
              sequence="1"
              groups="base.group_user"/>

    <record id="action_employee" model="ir.actions.act_window">
      <field name="name">Employees</field>
      <field name="res_model">emp.employee</field>
      <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_employee_root"
              name="Employees"
              parent="menu_hr_root"
              sequence="2"
              groups="base.group_user"/>

    <menuitem id="menu_employee"
              name="Manage Employees"
              parent="menu_employee_root"
              action="action_employee"
              sequence="1"
              groups="base.group_user"/>

    <record id="action_department" model="ir.actions.act_window">
      <field name="name">Departments</field>
      <field name="res_model">emp.department</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_department_root"
              name="Departments"
              parent="menu_hr_root"
              sequence="3"
              groups="base.group_user"/>

    <menuitem id="menu_manage_departments"
              name="Manage Departments"
              parent="menu_department_root"
              action="action_department"
              sequence="1"
              groups="base.group_user"/>

  </data>
</odoo>
